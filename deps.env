# Pinned dependency refs for reproducible sdr2wifi builds.
# Sourced by scripts/build-deps.sh, the Dockerfile, and referenced in the docs.
# gr-foo is vanilla upstream; the modern-OFDM decode lives in the gr-ieee802-11 fork.

GRFOO_REPO="https://github.com/bastibl/gr-foo.git"
GRFOO_REF="4c2a471b0453b9dca669b2d9dfcbfba6278741d7"   # maint-3.10

GRIEEE_REPO="https://github.com/josephnef/gr-ieee802-11.git"
GRIEEE_REF="4dbf31ed85cebd4412c290b196eb359ed30e9166"   # feat/ht-vht-rx (HT/VHT/STBC/LDPC decode + over-air sync fix)

GNURADIO_SERIES="3.10"   # built/tested against GNU Radio 3.10.x, Python 3.14
